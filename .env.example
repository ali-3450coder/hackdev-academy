# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_minimum_64_character_random_string_for_production_use
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER_EXPIRES=30d

# Database
DB_CLIENT=sqlite3
DB_FILENAME=./dev.sqlite3

# Cookie
COOKIE_SECRET=change_this_to_a_minimum_32_character_random_string
COOKIE_SECURE=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000
