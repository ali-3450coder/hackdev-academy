# ═══════════════════════════════════════════════════════════════
# HackDev Academy — Ortam Değişkenleri Şablonu
#
# Bu dosyayı kopyala: cp .env.example .env
# Ardından .env dosyasını kendi değerlerinle doldur.
# .env dosyası GİT'E EKLENMEMELİDİR.
# ═══════════════════════════════════════════════════════════════

# ── Sunucu ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT Güvenlik ─────────────────────────────────────────────────
# Üretmek için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=BURAYA_EN_AZ_64_KARAKTERLIK_RASTGELE_STRING_YAZ

# Token süreleri
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER_EXPIRES=30d

# ── Veritabanı ───────────────────────────────────────────────────
# Geliştirme: sqlite3 | Production PostgreSQL istiyorsan: pg
DB_CLIENT=sqlite3
DB_FILENAME=./dev.sqlite3

# PostgreSQL kullanmak istersen (DB_CLIENT=pg yapılınca aktif olur):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Cookie Güvenlik ──────────────────────────────────────────────
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=BURAYA_EN_AZ_32_KARAKTERLIK_RASTGELE_STRING_YAZ

# Production'da HTTPS varsa true yap
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────
# Birden fazla origin: http://localhost:3000,https://sitein.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Seed Şifreleri (Sadece Geliştirme) ──────────────────────────
# Bu şifreler npm run db:seed ile oluşturulan hesaplara atanır.
# Production'da npm run db:seed KULLANMA!
SEED_ADMIN_PASSWORD=ADMIN_ICIN_GUCLU_BIR_SIFRE_YAZ
SEED_TEST_PASSWORD=TEST_KULLANICISI_ICIN_SIFRE_YAZ

# ═══════════════════════════════════════════════════════════════
# PRODUCTION ÖRNEĞİ (Railway / Render / VPS)
# ═══════════════════════════════════════════════════════════════
# NODE_ENV=production
# PORT=3000
# JWT_SECRET=<node -e komutuyla üretilen 64 char hex>
# COOKIE_SECRET=<node -e komutuyla üretilen 32 char hex>
# COOKIE_SECURE=true
# DB_CLIENT=sqlite3
# DB_FILENAME=/data/prod.sqlite3      ← Kalıcı disk yolu (Railway volume)
# ALLOWED_ORIGINS=https://sitenizin-adresi.com
